# Academic Copilot Agent Configuration

# Run in DEMO/MOCK mode without external API keys (default: true for instant zero-config testing)
MOCK_MODE=true

# LLM Provider Configuration (Required only when MOCK_MODE=false)
# Supported options: openai, google-genai
DEFAULT_LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL_NAME=gpt-4o-mini

# Google Gemini Alternative (when using google-genai)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-2.0-flash

# Optional Google Workspace Integration (Live Gmail & Google Drive API)
GOOGLE_CLIENT_SECRET_PATH=config/client_secret.json
GOOGLE_TOKEN_PATH=config/token.json

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true
